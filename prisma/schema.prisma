// Leave Management CRM — data model
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Pooled connection (PgBouncer) for the application's runtime queries.
  url = env("DATABASE_URL")

  // Migrations need a direct connection: a transaction pooler cannot run the
  // session-level statements DDL requires. On Neon this is the same host with
  // the "-pooler" segment removed. Falls back to DATABASE_URL when unset.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  /// Owns admin onboarding: invites administrators and approves their requests.
  SUPER_ADMIN
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  /// An admin who accepted an invitation and is awaiting a decision.
  PENDING_APPROVAL
  /// Refused by the super admin. Kept so the address cannot simply re-register.
  REJECTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Separates the two OTP flows. Without it a code mailed to verify an address
/// would also be accepted to reset that account's password, and vice versa.
enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// What a recorded attendance row says about the day.
///
/// There is deliberately no ABSENT: absence is the *lack* of a row, not a row
/// of its own. Storing it would need something to write it — a nightly sweep —
/// and would then have to be unwritten whenever the office turned out to be
/// closed or the person turned out to be on leave, which is exactly the
/// rewriting the holiday rules exist to avoid. `attendance.service.ts` derives
/// absence by asking who has no row, the same way allowances ask `holidays`.
///
/// One value today, and that is honest: the project has no working hours, so
/// LATE and HALF_DAY would be values nothing could ever write. The column
/// exists so they have somewhere to land once working hours are defined.
enum AttendanceStatus {
  PRESENT
}

/// How a remote-work period was asked for.
///
/// Kept because it is what the administrator *chose*, not a second copy of the
/// dates it produced. "One month from today" and a custom range that happens to
/// cover the same days are the same two dates and different instructions, and
/// the management screen is read by somebody asking which was meant. The dates
/// stay the only thing anything computes with — `resolveRemotePeriod` turns the
/// type into them once, when the assignment is written, and nothing re-derives
/// them afterwards. Editing a period therefore makes it CUSTOM, because that is
/// what it has become.
///
/// UNTIL_REVOKED is the one that is not a duration at all: it is the absence of
/// an end date, which is why `RemoteWorkAssignment.endDate` is nullable rather
/// than carrying a far-future sentinel every comparison would have to know about.
enum RemoteWorkType {
  TODAY
  TOMORROW
  WEEK
  MONTH
  CUSTOM
  UNTIL_REVOKED
}

/// What happened to a remote-work assignment, for the audit trail.
///
/// A table rather than columns on the row — deliberately the exception to this
/// codebase's habit of keeping an audit on the thing itself, which
/// `Attendance.markedById` makes the case for. That argument holds precisely
/// because a check-in is never amended: one row per person per day, and nothing
/// changes it. A remote period is the opposite kind of thing — its dates are
/// edited and then it is revoked — so the row can only ever describe its present
/// state, and the period it used to cover would be lost with every edit.
enum RemoteWorkAction {
  ASSIGNED
  MODIFIED
  REVOKED
}

/// How far the office-closed announcement has got.
///
/// SCHEDULED and SENT are the ordinary path, and a closure declared for *today*
/// reaches SENT in the same request that created it — the letter says "closed
/// today" rather than "closed tomorrow", so there is a real message to send.
/// SKIPPED is for a closure whose day is already over by the time anything tries
/// to announce it, which now only a sweep that has been down can produce.
/// CANCELLED marks an announcement called off because the closure moved or was
/// withdrawn, so a withdrawn row can never be picked up by a later sweep.
enum HolidayNotice {
  SCHEDULED
  SENT
  SKIPPED
  FAILED
  CANCELLED
}

/// Where an invitation has got to. "Expired" is deliberately absent: it is read
/// off `expiresAt` rather than stored, so no scheduled job is needed to keep the
/// column honest, and an invitation cannot sit open because nothing ran.
enum InvitationStatus {
  PENDING
  ACCEPTED
}

/// Where a complaint has got to.
///
/// Deliberately unlike `LeaveStatus`, whose PENDING and REJECTED are write-dead
/// because the allowance decides and nobody approves. A complaint is the
/// opposite kind of thing: it is a person asking to be heard, so every one of
/// these is reachable and a human decides which.
///
/// PENDING is where one lands. UNDER_REVIEW says somebody has picked it up, and
/// exists so an employee watching the screen can tell "nobody has looked yet"
/// from "somebody is on it" — the single most common question about a complaint.
/// RESOLVED and REJECTED are the two outcomes, and both owe the employee an
/// explanation, which is why `resolution` is required for either.
///
/// None of them is terminal. A complaint reopened after being resolved is an
/// ordinary thing to need, so the transitions are open and the *email* is what
/// is made once-only — see `Complaint.resolutionNoticeClaimedAt`.
enum ComplaintStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

/// Who a custom email was addressed to.
///
/// This is the permission boundary, not merely a label. INDIVIDUAL and EMPLOYEES
/// are delegable through `canSendEmails`; ADMINS and SELECTED_ADMINS through
/// `canEmailAdmins`. ALL_MEMBERS is the super admin's alone and is the only
/// audience that stays that way — writing to the entire organisation in one act
/// is the kind of announcement that has to answer to the person who owns the
/// system. The rule lives in `lib/email-audience.ts` and is enforced in
/// `custom-email.service.ts`, against the role and the grants read fresh from
/// this table, never against anything the browser claimed.
///
/// SELECTED_ADMINS is the only audience whose membership the *sender* chooses
/// rather than the role deciding it, which is why it is the only one whose
/// recipients are written down — see `EmailDispatch.recipientNames`.
enum EmailAudience {
  INDIVIDUAL
  EMPLOYEES
  ADMINS
  SELECTED_ADMINS
  ALL_MEMBERS
}

/// How a send actually went, across all its recipients.
///
/// PARTIAL exists because mail here is fire-and-forget per address: one bounced
/// mailbox out of forty is not a failed announcement, and recording the whole
/// thing as FAILED would make the log useless for the case it exists to answer —
/// "did this reach people?".
enum EmailDispatchStatus {
  SENT
  PARTIAL
  FAILED
}

/// One custom email, as an audit record.
///
/// Written for every send, successful or not, because the question this table
/// answers is "who wrote to the organisation, when, and did it arrive" — and a
/// send that failed is exactly the one somebody will come asking about.
///
/// The body is deliberately **not** stored. The brief asks for sender, audience,
/// count, time, subject and status, and keeping the message itself would turn an
/// access log into a copy of everybody's mail — the same restraint the leave
/// assistant shows by never persisting the raw prompt. The subject is enough to
/// identify which message is being discussed.
model EmailDispatch {
  id       String        @id @default(cuid())
  audience EmailAudience
  subject  String

  /// How many addresses were resolved, and how many the mailer accepted. Both
  /// are kept: "sent to 40, delivered 38" is the useful reading, and a single
  /// number could not express it.
  recipientCount Int
  deliveredCount Int
  status         EmailDispatchStatus

  createdAt DateTime @default(now())

  /// Restricted rather than cascading: deleting an administrator must not erase
  /// the record of what they sent the whole company.
  senderId String
  sender   Employee @relation("EmailSender", fields: [senderId], references: [id], onDelete: Restrict)

  /// Set only for INDIVIDUAL, where "one recipient" has a name worth keeping.
  /// Nulled rather than cascading if that account is deleted — the send still
  /// happened, and the count still says one.
  recipientId String?
  recipient   Employee? @relation("EmailRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  /// Who a SELECTED_ADMINS message actually went to, by name, and empty for
  /// every other audience.
  ///
  /// It is the one audience whose membership cannot be reconstructed later: the
  /// others are a population the role decides, so "ADMINS, 6 recipients" is a
  /// complete record, while a hand-picked set is a choice the sender made and
  /// nothing else remembers. Names rather than ids, and copied at send time
  /// rather than joined — the same argument `AttendanceWarning.consecutiveMissed`
  /// and `Attendance.lateBasisMinutes` make. This is what the record *said*, and
  /// a rename or a deleted account must not rewrite who was told something.
  recipientNames String[] @default([])

  @@index([senderId, createdAt])
  @@index([createdAt])
  @@map("email_dispatches")
}

/// A person in the system. Admins are Employees with role = ADMIN.
model Employee {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  emailVerified DateTime?
  role          Role           @default(EMPLOYEE)
  status        EmployeeStatus @default(ACTIVE)

  /// Whether this administrator may invite employees.
  ///
  /// Off by default: being made an admin does not by itself confer the right to
  /// onboard people. The super admin grants it per administrator, and it is read
  /// from here on every invitation rather than carried in the session, so
  /// revoking it takes effect on the next request instead of when a token
  /// expires. Meaningless for EMPLOYEE, and ignored for SUPER_ADMIN, who may
  /// always invite.
  canInviteEmployees Boolean @default(false)

  /// Whether this administrator may open and withdraw office days off.
  ///
  /// Granted per administrator exactly like `canInviteEmployees`, and for the
  /// same reason: closing the office is an organisation-wide act, so it is the
  /// super admin's to delegate rather than something every admin inherits. Read
  /// from here on every request, never from the session.
  canManageHolidays Boolean @default(false)

  /// Whether this administrator may write a custom email to people here.
  ///
  /// The third delegable right, following the same rule as the other two: off by
  /// default, granted per administrator, and read from the database on every
  /// send rather than carried in the session, so withdrawing it stops the next
  /// attempt instead of waiting for a week-old token to expire.
  ///
  /// It reaches the employees and nobody senior. An administrator holding this
  /// alone may write to one employee at a time or to all of them; writing to
  /// another administrator needs `canEmailAdmins`, and writing to the whole
  /// organisation at once stays with the super admin — see `EmailAudience`.
  canSendEmails Boolean @default(false)

  /// Whether this administrator may write to the other administrators.
  ///
  /// The sixth delegable right, and it is its own rather than folded into
  /// `canSendEmails` for the reason `canMarkAttendance` is not folded into
  /// `canViewAdminRecords`: writing to the people who run the system is a
  /// different act from writing to the staff, and an administrator given the
  /// second should not silently acquire the first. Off by default, granted per
  /// administrator by the super admin alone, read from here on every send.
  ///
  /// It unlocks two audiences — ADMINS, every administrator at once, and
  /// SELECTED_ADMINS, a hand-picked set — and it also widens the INDIVIDUAL
  /// picker, which without it offers employees only. That last part is the whole
  /// of why the grant means anything: a right to email administrators that could
  /// be walked around one administrator at a time would not be a boundary.
  ///
  /// ALL_MEMBERS is deliberately not among them. It is the audience that
  /// includes the super admin, and an announcement to the entire organisation
  /// stays with whoever owns it.
  canEmailAdmins Boolean @default(false)

  /// Whether this administrator may report on the administrators as a population.
  ///
  /// The fourth delegable right, and it follows the same rule as the other three:
  /// off by default, granted per administrator, read from the database on every
  /// request. It is the grant an HR administrator needs — the one person who has
  /// to chase attendance and count leave across everybody, administrators
  /// included, without being handed the super admin's account to do it with.
  ///
  /// What it actually unlocks is the `population` filter: the attendance roster
  /// (and so absences, which are derived from it) and the admin overview's
  /// headcount, leave figures and trend. Every administrator can already *see*
  /// administrators' attendance — the unfiltered roster lists every active
  /// account — so what this hands over is the ability to **separate** them out,
  /// which is the same thing as being told who they are.
  ///
  /// It grants the `EMPLOYEE` narrowing too, and that is not sloppiness: a filter
  /// that returned only the employees names the administrators just as precisely
  /// by subtraction from the unfiltered list.
  ///
  /// It never widens to the Staff screen. `role=ADMIN` on `/api/admin/employees`
  /// stays the super admin's, because that roster is the route to acting on those
  /// accounts rather than a report about them — see `assertMayManage`.
  canViewAdminRecords Boolean @default(false)

  /// Whether this administrator may record somebody present without the geofence.
  ///
  /// The fifth delegable right, and the only one that can write a fact the
  /// building would not have proved. It exists because somebody who genuinely
  /// came in can still fail to check in — a flat battery, a phone left at home,
  /// a fix too vague to place them — and until this there was no way to correct
  /// the record at all.
  ///
  /// Deliberately **not** folded into `canViewAdminRecords`. That one is a read:
  /// it decides who may report on administrators as a group. This is a write
  /// that overrides a physical check, and an HR administrator given the first
  /// should not silently acquire the second.
  ///
  /// Read from the database on every attempt, like the other four.
  canMarkAttendance Boolean @default(false)

  /// Whether this administrator may read and act on employee complaints.
  ///
  /// The seventh delegable right, and the one guarding the most sensitive
  /// reading in the system: a complaint is somebody reporting a problem about
  /// their workplace, often about a named colleague, written in the expectation
  /// that only the people who can act on it will see it. Being an administrator
  /// is not by itself a reason to read that, which is why it is off by default
  /// and granted per account by the super admin.
  ///
  /// Unlike `canSendEmails` or `canManageHolidays`, there is **no ungranted
  /// half**. Those two leave a screen somebody may look at and not use; here
  /// looking *is* the privilege, so an administrator without this reaches no
  /// complaint, no count and no list — and the nav item is not rendered at all.
  ///
  /// It carries the writes with it rather than splitting reading from resolving.
  /// An administrator trusted to read a complaint is trusted to answer it, and a
  /// second grant would mean somebody able to read every grievance in the
  /// company and do nothing about any of them.
  ///
  /// Read from the database on every request, like the other six.
  canManageComplaints Boolean @default(false)

  /// Whether this administrator may put people on remote work.
  ///
  /// The eighth delegable right, and it belongs in this list rather than being
  /// folded into an existing one because of what it actually does: a remote
  /// period makes every date it covers **attendance-exempt**, so the person is
  /// neither present nor absent for it and no warning letter can reach them.
  /// That is the ability to take somebody off the register, which is a stronger
  /// thing than `canMarkAttendance` — that one corrects one day in one
  /// direction, this one suspends the question indefinitely.
  ///
  /// Off by default, granted per administrator by the super admin, read from
  /// here on every request rather than carried in the session, so withdrawing it
  /// stops the next attempt instead of waiting for a week-old token to expire.
  canManageRemoteWork Boolean @default(false)

  /// Consecutive failed sign-ins since the last time the password was proven.
  /// Reset by a correct password, by verifying the address, or by a reset.
  failedLoginAttempts Int @default(0)

  /// When the attempt cap was reached. While set, the account cannot sign in
  /// however correct the password is: control of the mailbox has to be shown
  /// again first. Separate from `emailVerified` on purpose — clearing that
  /// would forget the address was ever proven, and would drop a locked-out
  /// administrator out of the super admin's approval queue.
  lockedAt DateTime?

  // Profile fields — collected after email verification, not at registration.
  phone        String?
  department   String?
  position     String?
  profilePhoto String?
  joiningDate  DateTime?

  /// When an administrator froze this person's own profile edits, and who did.
  ///
  /// **Deliberately not a kind of `EmployeeStatus`.** Suspending stops somebody
  /// signing in at all; this stops nothing but their own editing. A locked
  /// employee signs in, marks attendance, books leave and is counted in every
  /// figure exactly as before — the account is working, the details are frozen.
  /// Folding the two into one column would make "locked" and "suspended" a
  /// single ladder, and they are not even the same axis.
  ///
  /// Null means unlocked; the timestamp is the lock. Stored as a moment rather
  /// than a boolean so the screens can say *when*, which is the first thing
  /// somebody asks when they find they cannot change their phone number.
  ///
  /// It never blocks a password change. Locking somebody's details out of their
  /// reach is people-management; locking them out of their own credentials is a
  /// security regression, and `/api/profile/password` is deliberately untouched.
  ///
  /// `onDelete: SetNull` on the administrator, for the reason the attendance
  /// audit uses it: removing whoever set a lock must not remove the lock, or the
  /// person it was about.
  profileLockedAt   DateTime?
  profileLockedById String?
  /// Shown to the employee, so a frozen form explains itself rather than
  /// sending them to find an administrator to ask.
  profileLockReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileLockedBy Employee?  @relation("ProfileLockedBy", fields: [profileLockedById], references: [id], onDelete: SetNull)
  profilesLocked  Employee[] @relation("ProfileLockedBy")

  leaves             Leave[]
  attendance         Attendance[]
  attendanceMarked   Attendance[]        @relation("AttendanceMarkedBy")
  attendanceWarnings AttendanceWarning[]
  policiesUpdated    AttendancePolicy[]  @relation("AttendancePolicyAuthor")
  otpCodes           OtpCode[]
  invitationsSent    Invitation[]        @relation("InvitationIssuer")
  invitationAccepted Invitation?         @relation("InvitationAcceptor")
  holidaysDeclared   Holiday[]           @relation("HolidayAuthor")
  emailsSent         EmailDispatch[]     @relation("EmailSender")
  emailsReceived     EmailDispatch[]     @relation("EmailRecipient")
  complaints         Complaint[]         @relation("ComplaintAuthor")
  complaintsResolved Complaint[]         @relation("ComplaintResolver")

  remoteWork         RemoteWorkAssignment[] @relation("RemoteWorker")
  remoteWorkAssigned RemoteWorkAssignment[] @relation("RemoteWorkAssigner")
  remoteWorkRevoked  RemoteWorkAssignment[] @relation("RemoteWorkRevoker")
  remoteWorkActs     RemoteWorkEvent[]      @relation("RemoteWorkActor")

  @@index([department])
  @@index([status])
  @@index([role])
  @@map("employees")
}

/// One-time password issued for email verification.
model OtpCode {
  id         String     @id @default(cuid())
  employeeId String
  code       String
  purpose    OtpPurpose @default(EMAIL_VERIFICATION)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, purpose, createdAt])
  @@map("otp_codes")
}

/// A job title an administrator can assign when inviting someone.
///
/// Curated rather than free text so the same job is spelled one way across the
/// organisation — "Software Engineer" and "software engineer" would otherwise
/// both appear in filters. Accepting an invitation stamps the name onto the new
/// account's `position`; it deliberately does not become a third field
/// competing with `position` and `department` to describe the same thing.
model JobRole {
  id          String       @id @default(cuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  invitations Invitation[]

  @@map("job_roles")
}

/// An invitation to register, addressed to one email address.
///
/// The address is the whole point: an invitation admits exactly the mailbox it
/// was sent to, so it cannot be forwarded to onboard somebody else. `role` is
/// what the invitation grants, and it is the only thing that decides what the
/// holder becomes — registration reads the role off the invitation rather than
/// from which page the form was posted from. SUPER_ADMIN is deliberately not
/// issuable, so no invitation can ever mint another owner.
model Invitation {
  id    String @id @default(cuid())
  /// Normalised to lower case, and unique: one open invitation per address, so
  /// two administrators cannot invite the same person to two different roles.
  email String @unique

  /// SHA-256 of the token that travels in the emailed link.
  ///
  /// Hashed rather than stored plainly for the same reason passwords are: the
  /// raw token is a bearer credential, and a leaked database backup would
  /// otherwise hand over every open invitation. The link is the only copy.
  tokenHash String @unique

  role Role

  /// Job title the invitee is given on sign-up. Optional: an invitation may
  /// simply admit someone and leave the title to be filled in at profile setup.
  jobRoleId String?
  jobRole   JobRole? @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)

  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())

  invitedById String
  invitedBy   Employee @relation("InvitationIssuer", fields: [invitedById], references: [id], onDelete: Cascade)

  /// Cascades: an accepted invitation exists to record how one particular
  /// account came to be, so once that account is deleted it describes nothing.
  /// Deleting it also frees the address to be invited again.
  acceptedById String?   @unique
  acceptedBy   Employee? @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: Cascade)

  @@index([invitedById, createdAt])
  @@index([role, createdAt])
  @@map("invitations")
}

/// A day the whole office is closed.
///
/// Not a kind of leave, and deliberately not modelled as one: leave belongs to a
/// person and is drawn from their allowance, while this belongs to the calendar
/// and outranks anything an individual booked. A date listed here is simply not
/// a working day for anybody, so it costs nobody a day of their allowance —
/// including people who had already booked leave across it.
model Holiday {
  id String @id @default(cuid())

  /// The closed day, at UTC midnight like every other calendar date here.
  /// Unique: the office cannot be closed twice on the same day, and letting two
  /// rows claim one date would mean two announcements about it.
  date   DateTime @unique @db.Date
  reason String

  /// Where the office-closed announcement has got to, and when it is due.
  /// `noticeDueAt` is an instant, not a date: it is noon in the company's
  /// timezone on the day before, which is a different moment in UTC. For a
  /// closure declared for today it is the moment of declaring, since there is no
  /// day before left to wait for.
  notice       HolidayNotice @default(SCHEDULED)
  noticeDueAt  DateTime?
  noticeSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Kept as a record of who closed the office. Restricted rather than
  /// cascading: deleting an administrator must not silently reopen a day the
  /// whole company has already been told about.
  declaredById String
  declaredBy   Employee @relation("HolidayAuthor", fields: [declaredById], references: [id], onDelete: Restrict)

  /// The sweep looks for announcements that are due and not yet made, so it
  /// reads on exactly this pair.
  @@index([notice, noticeDueAt])
  @@map("holidays")
}

/// Company-wide attendance rules, as one row.
///
/// A singleton: `id` is fixed, so `upsert` on it is the only way to write and
/// there can never be two policies disagreeing about when the day ends. Read on
/// every sweep rather than carried anywhere, the same rule `canManageHolidays`
/// follows — changing the cutoff has to bite on the next sweep, not whenever
/// something cached happens to expire.
model AttendancePolicy {
  id String @id @default("policy")

  /// Minutes after midnight on the company's clock, so 17:00 is 1020. Stored as
  /// one number rather than hour and minute columns because every use of it is
  /// a comparison, and two columns would let them disagree.
  cutoffMinutes Int @default(1020)

  /// When the office opens and closes, on the company's clock, in the same
  /// minutes-after-midnight form as the cutoff above.
  ///
  /// These are **published facts, not rules**. Nothing judges attendance by
  /// them: a check-in is decided by the geofence and by whether the office was
  /// closed, never by the clock, so somebody who arrives early or stays late
  /// records the day exactly as anybody else does. They exist because people ask
  /// what the hours are and the assistant had nothing to answer from — so it
  /// invented an answer.
  ///
  /// Do **not** reach for these to fill `AttendanceStatus.LATE` or `HALF_DAY`.
  /// Those are absent because this project has no working hours in the sense
  /// that judges a person, and publishing an opening time does not create one.
  ///
  /// Lateness now exists and is still not measured from here. It is measured
  /// from `cutoffMinutes`, the deadline to have appeared at all, and is derived
  /// on read rather than stored in `status` — see `src/lib/lateness.ts`.
  /// Repointing it at `openingMinutes` would reclassify every check-in after
  /// 9am in the system's history as late, in one deploy and without a word.
  ///
  /// 9-to-5 is a starting value, not an assumption, exactly as `[1,2,3,4,5]` is
  /// below: a company opening at 08:30 and closing at 16:00 configures that.
  openingMinutes Int @default(540)
  closingMinutes Int @default(1020)

  /// How long past the cutoff a **delegated** administrator may still record
  /// somebody present, in minutes.
  ///
  /// The expiry is computed as `cutoff + this` on the company's clock and is
  /// never stored on an attendance row, because it is a fact about the *date*
  /// rather than about anybody's attendance — see `hrMarkWindowExpiresAt`. That
  /// is what makes a refreshed page, a new tab and a fresh sign-in all agree,
  /// and it is why raising this tomorrow cannot reopen yesterday: yesterday's
  /// cutoff has gone regardless of what the number says today.
  ///
  /// It binds `canMarkAttendance` and **not** the super admin, deliberately. The
  /// grant is the thing being time-boxed; somebody has to remain able to correct
  /// a record found wrong next week, or the feature that put this column here
  /// would have no counterpart. `assertMayCorrect` still applies to both.
  ///
  /// 20 is a starting value, not an assumption, exactly as 9-to-5 and
  /// `[1,2,3,4,5]` are. Zero is legal and means the permission ends the instant
  /// the deadline falls.
  hrMarkWindowMinutes Int @default(20)

  /// ISO weekday numbers attendance is expected on — 1 = Monday, 7 = Sunday.
  ///
  /// Without this the warning sweep would write to the whole company every
  /// Saturday and Sunday, since nothing else in this codebase knows a weekend
  /// from a working day. A date listed in `holidays` is still not a working day
  /// whatever this says: a declared closure outranks the ordinary week.
  workingDays Int[] @default([1, 2, 3, 4, 5])

  /// Off switch. The rules stay configured; nothing is sent while this is false.
  warningsEnabled Boolean @default(true)

  updatedAt   DateTime  @updatedAt
  updatedById String?
  updatedBy   Employee? @relation("AttendancePolicyAuthor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("attendance_policy")
}

/// A warning letter sent to one person about one missed working day.
///
/// The row is the claim, not the receipt: it is inserted *before* the email is
/// sent, so of any number of sweeps racing on the same person and day the unique
/// index picks exactly one winner. Claiming afterwards would leave a crash in
/// between looking identical to a day nobody had swept, and the letter would go
/// twice — the same reasoning `Holiday.claimNotice` follows.
model AttendanceWarning {
  id         String @id @default(cuid())
  employeeId String

  /// The working day that was missed, at UTC midnight like every calendar date.
  date DateTime @db.Date

  /// Working days missed in a row, this one included, as counted when the letter
  /// was written. Stored rather than recomputed because it is what the letter
  /// actually said, and a later closure or backdated leave would change the
  /// answer without changing the words already in somebody's inbox.
  consecutiveMissed Int @default(1)

  /// Null means the letter was claimed but delivery was never confirmed.
  /// Deliberately not retried: mail here is fire-and-forget everywhere else, and
  /// a retry that cannot tell "never sent" from "sent, logging failed" is how
  /// somebody gets the same warning twice.
  sentAt DateTime?

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance_warnings")
}

/// A single day of leave. Date and reason are extracted by the AI service;
/// the raw natural-language prompt is intentionally never persisted.
model Leave {
  id         String      @id @default(cuid())
  employeeId String
  leaveDate  DateTime    @db.Date
  reason     String
  status     LeaveStatus @default(PENDING)

  /// Set when an admin manually overrides the automatic decision.
  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, leaveDate])
  @@index([status])
  @@index([leaveDate])
  @@map("leaves")
}

/// One person turning up at the office on one day.
///
/// A row exists only when the check-in was accepted, so its presence *is* the
/// attendance: there is nothing here to correct afterwards and no rejected row
/// to sweep up. A refusal is reported to the employee and left at that.
///
/// The coordinates are kept because the row is the record of a claim that was
/// judged, and a distance with nothing behind it cannot be re-checked if the
/// geofence ever moves. `distanceMeters` is stored alongside them even though it
/// is derivable, so the admin screen can show what the server actually decided
/// on rather than recomputing against today's office location.
model Attendance {
  id         String @id @default(cuid())
  employeeId String

  /// The working day, at UTC midnight like every other calendar date here —
  /// derived from the company's clock, not the server's, so a check-in at 2am
  /// in Karachi belongs to that day rather than the one UTC is still on.
  date      DateTime @db.Date
  /// The instant the employee actually arrived. Rendered in APP_TIME_ZONE.
  ///
  /// Defaults to now because a geofenced check-in happens as it is recorded. An
  /// administrator correcting a day sets it **explicitly** to the arrival time
  /// they were told, which is deliberately not the moment they pressed the
  /// button: somebody who came in at 17:15 and was recorded at 17:20 was fifteen
  /// minutes late, not twenty. `markedAt` is what holds the latter, and holds it
  /// for audit rather than for arithmetic.
  checkInAt DateTime @default(now())

  /// The cutoff this day was judged against, in minutes after midnight.
  ///
  /// Copied from `AttendancePolicy.cutoffMinutes` when the row is written, and
  /// never recomputed. Lateness is therefore frozen at what the policy said on
  /// the day — the same reason `AttendanceWarning.consecutiveMissed` is stored
  /// rather than derived: it is what the record *said*, and moving the deadline
  /// next month must not silently rewrite how late somebody was last week.
  ///
  /// This is the one place attendance stores a judgement instead of deriving it,
  /// and it is safe precisely because it stores the *input* rather than the
  /// verdict. `minutesLate` is still computed on every read, so there is no
  /// second copy of the answer to fall out of step with the check-in time.
  lateBasisMinutes Int

  status AttendanceStatus @default(PRESENT)

  /// What the device reported, and what the server made of it. Written only
  /// after the server has decided; the client's own verdict is never read.
  ///
  /// **Null exactly when an administrator recorded this rather than the geofence
  /// proving it.** They are not defaulted to the office's own coordinates, which
  /// would be the convenient thing and would forge a reading nobody took: a row
  /// claiming somebody stood 0m from the door is indistinguishable from one where
  /// they did. Nullable is the honest shape — the server knows nothing about
  /// where this person was, and says so.
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  distanceMeters Float?

  /// Who asserted this, when, and why — set together with the nulls above, and
  /// null together with them. A row either was proved by the building or was
  /// vouched for by a named administrator, and it says which for as long as it
  /// exists.
  ///
  /// This is the audit trail, and it lives on the row rather than in a log table
  /// because `@@unique([employeeId, date])` means there is only ever one row per
  /// person per day to describe. Nothing amends a check-in: an administrator may
  /// create the row where none existed, and that is the whole of what can happen
  /// to it short of the reset deleting it.
  ///
  /// `onDelete: SetNull` rather than Cascade — deleting the administrator who
  /// made the correction must not delete the attendance of the person it was
  /// about. The row survives having lost the name of who vouched for it, which
  /// is a worse record than before and a far better one than none.
  markedById String?
  markedAt   DateTime?
  reason     String?

  createdAt DateTime @default(now())

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  markedBy Employee? @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  /// One check-in per person per day, settled by the database rather than only
  /// by the service that looked a moment earlier — two taps racing on a flaky
  /// connection is the ordinary case, not the exotic one.
  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

/// One employee raising a problem, and what was done about it.
///
/// The employee is the `employeeId` relation and nothing else. Their name and
/// address are **not** copied onto the row, deliberately unlike
/// `EmailDispatch.recipientNames`, which does copy them: that field records who
/// was told something at a moment in time, where a rename must not rewrite
/// history. This is a live case somebody is still working, so the current name
/// and the current address are the right answers — and the address in particular
/// has to be looked up rather than stored, because the resolution email must
/// reach whoever the account belongs to now.
///
/// Cascade on delete: a complaint is about the person who wrote it, so removing
/// the account removes the complaint with it. That is the opposite of
/// `EmailDispatch`, which is Restrict — an audit record of what somebody sent
/// the company must outlive them, while a grievance nobody can follow up is only
/// a copy of somebody's private words with no one left to act on it.
model Complaint {
  id          String          @id @default(cuid())
  employeeId  String
  subject     String
  description String
  status      ComplaintStatus @default(PENDING)

  /// What was decided, written by whoever closed it. Shown to the employee, so
  /// it is required for RESOLVED and REJECTED alike — an outcome with no words
  /// against it is the thing that generates the next complaint.
  resolution String?

  /// Admin-only working notes. **Never** selected into anything an employee can
  /// reach: `employeeComplaintSelect` omits it, which is the same mechanism
  /// `employeeSelect` uses to omit the password hash. Don't add it there.
  internalNotes String?

  /// `SetNull` rather than Cascade, matching `Attendance.markedBy`: deleting the
  /// administrator who resolved something must not delete the resolution, nor
  /// the complaint it belongs to.
  resolvedById String?
  resolvedBy   Employee? @relation("ComplaintResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  /// The claim that stops a second resolution email, and the proof one arrived.
  ///
  /// Two columns rather than one because they answer different questions, and
  /// this is the same split `Holiday.notice`/`noticeSentAt` and
  /// `AttendanceWarning.claim`/`sentAt` already make. `claimedAt` is written
  /// **before** a word is sent, by a conditional update that exactly one caller
  /// can win — so a double-submitted request, a refreshed page, or two admins
  /// resolving at once produce one email. `sentAt` is written only once the
  /// mailer accepted it.
  ///
  /// Claimed with `sentAt` still null therefore means *tried and failed*, which
  /// is a state the admin screen reports rather than hides. It is deliberately
  /// **not** retried: mail is fire-and-forget everywhere here, and a retry that
  /// cannot tell "never sent" from "sent, then the write failed" is how somebody
  /// gets the same letter twice.
  ///
  /// Neither is cleared when a complaint is reopened. That is what makes
  /// resolving, unresolving and resolving again send exactly one email.
  resolutionNoticeClaimedAt DateTime?
  resolutionNoticeSentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee              @relation("ComplaintAuthor", fields: [employeeId], references: [id], onDelete: Cascade)
  attachments ComplaintAttachment[]

  @@index([employeeId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("complaints")
}

/// A file an employee attached to a complaint.
///
/// A table of its own rather than a column on `Complaint`, and that is the whole
/// point: the bytes live somewhere the list query never touches. `complaintSelect`
/// takes the filename and size to show a paperclip; only opening one complaint
/// fetches `data`. A blob on the parent row would be dragged into every page of
/// the admin table by every `findMany` that forgot to exclude it.
///
/// Stored as a data URL, which is the project's existing answer to file storage —
/// the same one `profilePhoto` uses, and for the same stated reason: no object
/// store to stand up for local development. The cap is enforced in
/// `complaint.schema.ts`.
model ComplaintAttachment {
  id          String @id @default(cuid())
  complaintId String
  filename    String
  contentType String

  /// Bytes as reported by the parsed data URL, so a list can show a size
  /// without decoding the payload.
  size Int

  /// The `data:` URL itself. Selected only when one complaint is opened.
  data String

  createdAt DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_attachments")
}

/// A stretch of days one person works away from the office.
///
/// **Remote is not attendance, and that is the whole model.** A date this covers
/// is attendance-*exempt*: `describeDay` returns REMOTE for it, so the person is
/// not present, not absent and not on leave, no warning letter can reach them
/// for it, and every report drops it out of the attendance denominator rather
/// than counting it as a day they failed to appear. Nothing is written to
/// `attendance` or `leaves` when a period is assigned — the exemption is derived
/// from this row on every read, exactly as absence and closures are, so
/// shortening or revoking a period puts the days back with nothing to migrate.
///
/// **There is deliberately no `status` column.** Active, expired, scheduled and
/// revoked are all readable off the three dates and `revokedAt`, and a stored
/// copy would need something to keep it honest — the same argument
/// `InvitationStatus` makes for having no "expired" value, and the same one
/// `AttendanceStatus` makes for having no ABSENT. A period that ended last night
/// would otherwise sit at ACTIVE until a sweep ran, and there is no sweep.
///
/// **Coverage is one predicate**: `startDate <= day AND (endDate IS NULL OR
/// endDate >= day)`. Every query that asks whether somebody is remote asks
/// exactly that, which is what the two indexes below are for.
model RemoteWorkAssignment {
  id         String @id @default(cuid())
  employeeId String

  /// First and last day covered, at UTC midnight like every calendar date here.
  ///
  /// `endDate` null means **until revoked** — an open period, not a missing
  /// value. A sentinel far-future date would have been the alternative and every
  /// comparison in the codebase would have had to know the number.
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  /// How the period was asked for. See `RemoteWorkType` — kept as the
  /// instruction, never re-derived into dates.
  type RemoteWorkType

  /// Why this person is working remotely. Required: an exemption from the
  /// attendance register with nothing said about it is the kind of record
  /// somebody has to reconstruct from memory a quarter later.
  reason String

  /// When the period was called off, by whom, and what they said about it.
  ///
  /// Revoking **does not delete coverage already served.** It writes `endDate`
  /// to the day of revocation, so the days somebody has genuinely worked from
  /// home stay exempt and only the future returns to the register — otherwise
  /// calling off a period would retroactively mark a fortnight of legitimate
  /// remote work as absence, which is precisely the false record this feature
  /// exists to avoid.
  ///
  /// A period revoked **before it started** is closed to an empty range —
  /// `endDate` lands one day before `startDate` — so the coverage predicate
  /// matches nothing at all. That is the honest shape for an instruction that
  /// never took effect, and it is why nothing here constrains `endDate >=
  /// startDate`: that rule belongs to *input*, and is enforced in
  /// `remote-work.schema.ts`.
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedById String

  employee   Employee  @relation("RemoteWorker", fields: [employeeId], references: [id], onDelete: Cascade)
  /// Restricted rather than cascading: deleting the administrator who put
  /// somebody on remote work must not silently put that person back on the
  /// attendance register, which is what removing the row would do.
  assignedBy Employee  @relation("RemoteWorkAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  /// `SetNull`, for the reason `Attendance.markedBy` uses it — losing the name
  /// of who called a period off is a worse record; losing the revocation itself
  /// would be a wrong one.
  revokedBy  Employee? @relation("RemoteWorkRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  events RemoteWorkEvent[]

  /// The coverage question, asked per person and asked company-wide, so both
  /// have an index to read.
  @@index([employeeId, startDate, endDate])
  @@index([startDate, endDate])
  @@map("remote_work_assignments")
}

/// One thing that happened to a remote-work assignment.
///
/// The audit trail §20 asks for, and a table rather than columns on the row for
/// the reason `RemoteWorkAction` gives: the period is edited, so the row cannot
/// carry its own history. Both the previous and the new period are copied in by
/// value at the moment of the change — the same argument
/// `EmailDispatch.recipientNames` and `AttendanceWarning.consecutiveMissed`
/// make. This is what the record *said*, and a later edit must not rewrite it.
model RemoteWorkEvent {
  id           String           @id @default(cuid())
  assignmentId String
  employeeId   String
  action       RemoteWorkAction

  /// The period before and after, both nullable in their end date for the same
  /// reason the assignment's is. `previousStart` is null for ASSIGNED, where
  /// there was no period before.
  previousStart DateTime? @db.Date
  previousEnd   DateTime? @db.Date
  newStart      DateTime? @db.Date
  newEnd        DateTime? @db.Date

  /// What was said at the time — the assignment's reason, or the revocation's.
  reason String?

  createdAt DateTime @default(now())

  /// Nullable and `SetNull`: an audit entry outlives the account that made it,
  /// and an event nobody can be named for is still a fact about the assignment.
  actorId String?
  actor   Employee? @relation("RemoteWorkActor", fields: [actorId], references: [id], onDelete: SetNull)

  assignment RemoteWorkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
  @@index([employeeId, createdAt])
  @@map("remote_work_events")
}
