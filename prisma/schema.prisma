// Leave Management CRM — data model
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Pooled connection (PgBouncer) for the application's runtime queries.
  url = env("DATABASE_URL")

  // Migrations need a direct connection: a transaction pooler cannot run the
  // session-level statements DDL requires. On Neon this is the same host with
  // the "-pooler" segment removed. Falls back to DATABASE_URL when unset.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  /// Owns admin onboarding: issues invite keys and approves admin requests.
  SUPER_ADMIN
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  /// An admin who registered with an invite key and is awaiting a decision.
  PENDING_APPROVAL
  /// Refused by the super admin. Kept so the address cannot simply re-register.
  REJECTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Separates the two OTP flows. Without it a code mailed to verify an address
/// would also be accepted to reset that account's password, and vice versa.
enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// A person in the system. Admins are Employees with role = ADMIN.
model Employee {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  emailVerified DateTime?
  role          Role           @default(EMPLOYEE)
  status        EmployeeStatus @default(ACTIVE)

  // Profile fields — collected after email verification, not at registration.
  phone        String?
  department   String?
  position     String?
  profilePhoto String?
  joiningDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaves        Leave[]
  otpCodes      OtpCode[]
  invitesIssued InviteKey[] @relation("InviteIssuer")
  inviteUsed    InviteKey?  @relation("InviteRedeemer")

  @@index([department])
  @@index([status])
  @@index([role])
  @@map("employees")
}

/// One-time password issued for email verification.
model OtpCode {
  id         String     @id @default(cuid())
  employeeId String
  code       String
  purpose    OtpPurpose @default(EMAIL_VERIFICATION)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, purpose, createdAt])
  @@map("otp_codes")
}

/// A one-shot invitation to register, as either an employee or an administrator.
///
/// Single-use by design: redeeming one ties it to the account that used it, so
/// a leaked key cannot onboard a stream of strangers and every account can be
/// traced back to the invitation it came through.
///
/// `role` is what the key grants, and it is the only thing that decides what the
/// holder becomes — registration reads the role off the key rather than from
/// which page the form was posted from, so a key can never be used to claim a
/// role it was not issued for. SUPER_ADMIN is deliberately not issuable.
model InviteKey {
  id         String    @id @default(cuid())
  key        String    @unique
  role       Role
  /// Free-text note of who the key was meant for.
  label      String?
  expiresAt  DateTime
  revokedAt  DateTime?
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  issuedById String
  issuedBy   Employee @relation("InviteIssuer", fields: [issuedById], references: [id], onDelete: Cascade)

  redeemedById String?   @unique
  redeemedBy   Employee? @relation("InviteRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([issuedById, createdAt])
  @@index([role, createdAt])
  @@map("invite_keys")
}

/// A single day of leave. Date and reason are extracted by the AI service;
/// the raw natural-language prompt is intentionally never persisted.
model Leave {
  id         String      @id @default(cuid())
  employeeId String
  leaveDate  DateTime    @db.Date
  reason     String
  status     LeaveStatus @default(PENDING)

  /// Set when an admin manually overrides the automatic decision.
  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, leaveDate])
  @@index([status])
  @@index([leaveDate])
  @@map("leaves")
}
