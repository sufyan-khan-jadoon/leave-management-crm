#-----------------------------------------------------------------------------
# Database — PostgreSQL (Neon, Supabase, or local)
# Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# Local:    postgresql://postgres:postgres@localhost:5432/leave_crm?schema=public
#-----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leave_crm?schema=public"

#-----------------------------------------------------------------------------
# Authentication (NextAuth v5)
# Generate a secret with: openssl rand -base64 32
#-----------------------------------------------------------------------------
NEXTAUTH_SECRET="replace-me-with-a-32-character-minimum-random-string"
NEXTAUTH_URL="http://localhost:3000"

#-----------------------------------------------------------------------------
# Google Gemini — free tier key from https://aistudio.google.com/app/apikey
#-----------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

#-----------------------------------------------------------------------------
# Email (Nodemailer SMTP)
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
#        host=smtp.gmail.com  port=587  secure=false
#-----------------------------------------------------------------------------
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="your-address@gmail.com"
EMAIL_PASSWORD="your-16-character-app-password"
EMAIL_FROM="Leave CRM <your-address@gmail.com>"

#-----------------------------------------------------------------------------
# Application
#-----------------------------------------------------------------------------
APP_NAME="Leave CRM"
HR_CONTACT_PHONE="+923145868205"

#-----------------------------------------------------------------------------
# Seed credentials (used by `npm run db:seed`)
#-----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin123@"
SEED_ADMIN_NAME="System Administrator"
# Set to "true" to also create demo employees and leave history.
SEED_DEMO_DATA="true"
